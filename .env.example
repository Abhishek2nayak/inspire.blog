# ---------------------------------------------------------------------------
# Makeframe — environment template
#
# Copy to .env and fill in.
# NEVER put real values in this file — it is committed to git.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Postgres connection string (Neon, Supabase, local, ...).
DATABASE_URL=""

# --- Auth (NextAuth) ------------------------------------------------------
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth is optional — the provider is only registered when BOTH are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Site -----------------------------------------------------------------
# Public origin, no trailing slash. Used for canonicals, OG tags, sitemap,
# robots.txt and the RSS feed. MUST be the real domain in production — if it
# is wrong, canonical tags point elsewhere and the site will not rank.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Search Console verification token for THIS domain. Optional.
NEXT_PUBLIC_GOOGLE_VERIFICATION=""

# --- Admin ----------------------------------------------------------------
# Comma-separated allowlist. Seeding promotes these users to role=ADMIN.
# FAILS CLOSED: empty means nobody is an admin.
ADMIN_EMAILS=""

# --- Anthropic (AI writer) ------------------------------------------------
# Required by the article / prompt / tool generators.
# Get a key at https://console.claude.com
ANTHROPIC_API_KEY=""

# --- Cloudinary (image + video uploads) -----------------------------------
# Required by POST /api/upload — prompt example images, tool logos.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Ads (optional) -------------------------------------------------------
# Ad slots render nothing when this is unset.
NEXT_PUBLIC_ADSENSE_CLIENT=""

# --- Marketplace ----------------------------------------------------------
# Paid prompt listings stay hidden until checkout is wired up, so a seller
# can't price something nobody is able to buy. Set to "true" once Stripe is live.
NEXT_PUBLIC_PAID_PROMPTS="false"
