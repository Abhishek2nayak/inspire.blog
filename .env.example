# ---------------------------------------------------------------------------
# Makeframe — environment template
#
# Copy to .env and fill in.
# NEVER put real values in this file — it is committed to git.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Postgres connection string (Supabase, Neon, local, ...).
#
# PERCENT-ENCODE RESERVED CHARACTERS IN THE PASSWORD. This is the single most
# common way this value breaks, and the error message does not name the culprit
# — Prisma just reports "the URL must start with the protocol postgresql://" or
# "check the string for any illegal characters", both of which point you at the
# scheme rather than at the password.
#
#     #  ->  %23      @  ->  %40      /  ->  %2F      :  ->  %3A
#     ?  ->  %3F      [  ->  %5B      ]  ->  %5D      %  ->  %25
#
# `#` is the usual offender: in a URL it begins the fragment, so everything
# after it — including @host:port/db — is silently discarded.
#
# Keep the value in double quotes so a literal `#` cannot be read as a comment.
#
# DATABASE_URL is the RUNTIME connection. On Supabase use the transaction
# pooler (port 6543) with `?pgbouncer=true` — serverless opens a connection per
# function instance and a direct connection exhausts the cap. The username
# gains the project ref: postgres.<project-ref>
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL is used ONLY by `prisma migrate` / `prisma db push`. DDL cannot run
# through pgbouncer, so this must be the direct connection (port 5432).
# If your CI is IPv4-only and this fails, use Supabase's *session* pooler here
# rather than buying the IPv4 add-on. Never use the session pooler for
# DATABASE_URL — it holds a connection per client, which is what breaks
# serverless in the first place.
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# --- Auth (NextAuth) ------------------------------------------------------
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth is optional — the provider is only registered when BOTH are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Site -----------------------------------------------------------------
# Public origin, no trailing slash. Used for canonicals, OG tags, sitemap,
# robots.txt and the RSS feed. MUST be the real domain in production — if it
# is wrong, canonical tags point elsewhere and the site will not rank.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Search Console verification token for THIS domain. Optional.
NEXT_PUBLIC_GOOGLE_VERIFICATION=""

# --- Admin ----------------------------------------------------------------
# Comma-separated allowlist. Seeding promotes these users to role=ADMIN.
# FAILS CLOSED: empty means nobody is an admin.
ADMIN_EMAILS=""

# --- Anthropic (AI writer) ------------------------------------------------
# Required by the article / prompt / tool generators.
# Get a key at https://console.claude.com
ANTHROPIC_API_KEY=""

# --- Cloudinary (image + video uploads) -----------------------------------
# Required by POST /api/upload — prompt example images, tool logos.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Ads (optional) -------------------------------------------------------
# Ad slots render nothing when this is unset.
NEXT_PUBLIC_ADSENSE_CLIENT=""

# --- Marketplace ----------------------------------------------------------
# Paid prompt listings stay hidden until checkout is wired up, so a seller
# can't price something nobody is able to buy. Set to "true" once Stripe is live.
NEXT_PUBLIC_PAID_PROMPTS="false"
